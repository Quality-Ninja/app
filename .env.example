# Build settings for the web app. Every value here is public: it is written into the site's pages.
# For local development, copy this file to .env.local and fill it in; `npm run dev` reads it.

# The API origin, with no path, e.g. https://api.example.com. Defaults to http://localhost:8000.
API_BASE_URL=
# The Clerk publishable key (pk_test_… or pk_live_…), from the same Clerk instance as the API. Never a secret key.
CLERK_PUBLISHABLE_KEY=
# The Clerk Frontend API origin, e.g. https://clerk.example.com (the API's CLERK_ISSUER).
CLERK_FRONTEND_API=
# The QA Ninja extension's ID (32 letters, a to p), which "Run on this computer" messages. Defaults to
# omlmffaaomacajicfhfofoackdnfocdg, the ID the extension's manifest key gives it.
EXTENSION_ID=
# Set to production for release builds: they require HTTPS origins and a pk_live_ key.
APP_ENV=
